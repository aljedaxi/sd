#!/usr/bin/env nix
#! nix shell github:aljedaxi/de-logseqify-markdown --command bash
#grab dc.type=text files and convert them to html

read -r -d '' preamble <<- EOF
<!doctype html>
<html lang="en-ca">
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1.0">
<link href="/classless.css" rel="stylesheet">
EOF
read -r -d '' postamble <<- EOF
</html>
EOF

sd zettel api | while read x; 
do
  justName=`basename "${x%.*}" | sed "s/ /-/g"`
  mkdir -p ~/prog/dasein-output/${justName}
  echo $justName
  echo $preamble > $HOME/prog/dasein-output/${justName}/index.html
  de-logseqify-markdown "$HOME/zettel/pages/$x.md" >> $HOME/prog/dasein-output/${justName}/index.html
  echo $postamble >> $HOME/prog/dasein-output/${justName}/index.html
done
