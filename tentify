#!/usr/bin/env janet
#turn a bandcamp url into a tent url

(import uri)

(defn tentify [uri-obj]
  (let [{:host host :path path} uri-obj
        [_ type name] (string/split "/" path)
        [artist] (string/split "." host)]
    (string/format "https://tent.bloat.cat/release.php?artist=%s&type=%s&name=%s" artist type name)))

(defn to-tent [s]
  (->> s string string/trim uri/parse tentify))

(defn main
  [& args]
  (->> stdin file/lines (map to-tent) (map print)))
